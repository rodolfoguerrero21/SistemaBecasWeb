@model List<SistemaBecasWeb.Models.SolicitudBeca>
@{
    ViewData["Title"] = "Solicitudes de Beca";
}

<div class="container mt-4">
    <h2>📋 Listado de Solicitudes de Beca</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-action="Crear" class="btn btn-primary mb-3">➕ Nueva Solicitud</a>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No hay solicitudes registradas.</div>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>RUT</th>
                    <th>Carrera</th>
                    <th>Promedio</th>
                    <th>Puntaje</th>
                    <th>Resultado</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.IdSolicitud</td>
                        <td>@s.NombreEstudiante</td>
                        <td>@s.Rut</td>
                        <td>@s.Carrera</td>
                        <td>@s.PromedioNotas</td>
                        <td><strong>@s.Puntaje</strong></td>
                        <td>
                            @if (s.Resultado == "Recomendada")
                            {
                                <span class="badge bg-success">@s.Resultado</span>
                            }
                            else if (s.Resultado == "En revisión")
                            {
                                <span class="badge bg-warning text-dark">@s.Resultado</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@s.Resultado</span>
                            }
                        </td>
                        <td>@s.EstadoSolicitud</td>
                        <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@s.IdSolicitud" class="btn btn-info btn-sm">Ver</a>
                            <a asp-action="Editar" asp-route-id="@s.IdSolicitud" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@s.IdSolicitud" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>