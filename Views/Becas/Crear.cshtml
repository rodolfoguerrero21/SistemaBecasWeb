@model SistemaBecasWeb.Models.SolicitudBeca
@{
    ViewData["Title"] = "Nueva Solicitud de Beca";
}

<div class="container mt-4">
    <h2>📝 Registrar Solicitud de Beca</h2>
    <hr />

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="NombreEstudiante" class="form-label"></label>
                <input asp-for="NombreEstudiante" class="form-control" placeholder="Nombre completo" />
                <span asp-validation-for="NombreEstudiante" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Rut" class="form-label"></label>
                <input asp-for="Rut" class="form-control" placeholder="12345678-9" />
                <span asp-validation-for="Rut" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Carrera" class="form-label"></label>
            <input asp-for="Carrera" class="form-control" placeholder="Ej: Ingeniería en Informática" />
            <span asp-validation-for="Carrera" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PromedioNotas" class="form-label"></label>
                <input asp-for="PromedioNotas" class="form-control" type="number" step="0.1" min="1" max="7" />
                <span asp-validation-for="PromedioNotas" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="IngresoFamiliar" class="form-label"></label>
                <input asp-for="IngresoFamiliar" class="form-control" type="number" min="0" placeholder="Ej: 500000" />
                <span asp-validation-for="IngresoFamiliar" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="IntegrantesFamilia" class="form-label"></label>
                <input asp-for="IntegrantesFamilia" class="form-control" type="number" min="1" placeholder="Ej: 4" />
                <span asp-validation-for="IntegrantesFamilia" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="SituacionLaboral" class="form-label"></label>
            <select asp-for="SituacionLaboral" class="form-select">
                <option value="">-- Seleccione --</option>
                <option value="Trabaja">Trabaja</option>
                <option value="No trabaja">No trabaja</option>
            </select>
            <span asp-validation-for="SituacionLaboral" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">💾 Registrar Solicitud</button>
            <a asp-action="Index" class="btn btn-secondary">← Volver al Listado</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}