@model SistemaBecasWeb.Models.SolicitudBeca
@{
    ViewData["Title"] = "Detalle de Solicitud";
}

<div class="container mt-4">
    <h2>🔍 Detalle de Solicitud #@Model.IdSolicitud</h2>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Nombre Estudiante</dt>
                <dd class="col-sm-8">@Model.NombreEstudiante</dd>

                <dt class="col-sm-4">RUT</dt>
                <dd class="col-sm-8">@Model.Rut</dd>

                <dt class="col-sm-4">Carrera</dt>
                <dd class="col-sm-8">@Model.Carrera</dd>

                <dt class="col-sm-4">Promedio de Notas</dt>
                <dd class="col-sm-8">@Model.PromedioNotas</dd>

                <dt class="col-sm-4">Ingreso Familiar</dt>
                <dd class="col-sm-8">$@Model.IngresoFamiliar.ToString("N0")</dd>

                <dt class="col-sm-4">Integrantes Familia</dt>
                <dd class="col-sm-8">@Model.IntegrantesFamilia</dd>

                <dt class="col-sm-4">Situación Laboral</dt>
                <dd class="col-sm-8">@Model.SituacionLaboral</dd>

                <dt class="col-sm-4">Puntaje Calculado</dt>
                <dd class="col-sm-8"><strong>@Model.Puntaje puntos</strong></dd>

                <dt class="col-sm-4">Resultado</dt>
                <dd class="col-sm-8">
                    @if (Model.Resultado == "Recomendada")
                    {
                        <span class="badge bg-success fs-6">@Model.Resultado</span>
                    }
                    else if (Model.Resultado == "En revisión")
                    {
                        <span class="badge bg-warning text-dark fs-6">@Model.Resultado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">@Model.Resultado</span>
                    }
                </dd>

                <dt class="col-sm-4">Estado Solicitud</dt>
                <dd class="col-sm-8">@Model.EstadoSolicitud</dd>

                <dt class="col-sm-4">Fecha Solicitud</dt>
                <dd class="col-sm-8">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <a asp-action="Editar" asp-route-id="@Model.IdSolicitud" class="btn btn-warning">✏️ Editar</a>
        <a asp-action="Index" class="btn btn-secondary">← Volver</a>
    </div>
</div>